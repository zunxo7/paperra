# Copy to `.env` and/or `.env.local` (`.env.local` overrides — used by `load-env.ts`).
# Never commit real keys; `.env.local` is usually gitignored.
#
# Vercel: add the same variables in Project → Settings → Environment Variables
# (Production / Preview). `load-env.ts` is a no-op on Vercel; secrets come from the platform.

OPENAI_API_KEY=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin panel (triple-click book icon) — required for POST /api/admin/login
ADMIN_PASSWORD=
